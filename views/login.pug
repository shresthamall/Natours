extends base

block append head
    script(src='https://unpkg.com/axios/dist/axios.min.js')

mixin formBox(_for='', _label='', _id='', _type='', _placeholder='', _minlength=1)
    .form__group
        label.form__label(for= _for)= l_abel
        input.form__input(id= _id,type= _type, placeholder=_placeholder, required, minlength=_minlength)

block content
    main.main
        .login-form.form--login
            h2.heading-secondary.ma-bt-lg Log into your account
            form(class= 'form' autocomplete='off')
                +formBox('email', 'Email address', 'email', 'email', 'you@example.com')
                +formBox('password', 'Password', 'password', 'password', '••••••••', 8)
                .form__group
                    button.btn.btn--green Login

block append footer 
